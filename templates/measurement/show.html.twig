{% extends 'base.html.twig' %}

{% block title %}Measurement{% endblock %}

{% block body %}
    <h1>Measurement</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ measurement.id }}</td>
            </tr>
            <tr>
                <th>MeasuredAt</th>
                <td>{{ measurement.measuredAt ? measurement.measuredAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>TempCelsius</th>
                <td>{{ measurement.tempCelsius }}</td>
            </tr>
            <tr>
                <th>PrecipitationMm</th>
                <td>{{ measurement.precipitationMm }}</td>
            </tr>
            <tr>
                <th>WindSpeedKmh</th>
                <td>{{ measurement.windSpeedKmh }}</td>
            </tr>
            <tr>
                <th>PressureHpa</th>
                <td>{{ measurement.pressureHpa }}</td>
            </tr>
            <tr>
                <th>HumidityPercent</th>
                <td>{{ measurement.humidityPercent }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_measurement_index') }}">back to list</a>

    <a href="{{ path('app_measurement_edit', {'id': measurement.id}) }}">edit</a>

    {{ include('measurement/_delete_form.html.twig') }}
{% endblock %}
