{% extends 'base.html.twig' %}

{# @var localization \App\Entity\Localization #}
{# @var measurement \App\Entity\Measurement #}

{% block title %}Weather in {{ localization.name }}, {{ localization.countryCode }}{% endblock %}

{% block body %}
    <main>
        <h1>Weather in {{ localization.name }}, {{ localization.countryCode }}</h1>

        <ul>
            {% for measurement in measurements %}
                <li>{{ measurement.measuredAt|date('d.m.Y') }}: {{ measurement.tempCelsius }}&deg;C</li>
            {% endfor %}
        </ul>
    </main>
{% endblock %}
